<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="fo-dicom" Version="5.1.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <!-- App_Data es el almacén de respaldo EN TIEMPO DE EJECUCIÓN (usuarios, bitácora, actividades,
       inventarios, Playbook…). No se publica: si no, cada `dotnet publish` pisaría los datos del
       servidor con los de la carpeta de desarrollo y enviaría a producción los hashes de las
       cuentas de prueba. El servicio crea la carpeta sola al arrancar. -->
  <ItemGroup>
    <Content Update="App_Data\**" CopyToPublishDirectory="Never" />
    <None Update="App_Data\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
