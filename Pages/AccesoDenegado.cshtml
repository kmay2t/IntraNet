@page
@{ ViewData["Title"] = "Acceso denegado"; }
@section Styles {
    @* Ancho unificado del sistema (`--page-max-width`, theme.css): solo esta página, el layout
       compartido con el inicio no se toca. *@
    <style>.wrap { max-width: var(--page-max-width); }</style>
}
<section class="hero">
  <p class="eyebrow">Acceso denegado</p>
  <h1>No tienes permiso para <em>esta página</em></h1>
  <p class="lede">Tu cuenta no tiene el rol necesario. Si crees que es un error, pide acceso al equipo de administración.</p>
  <p><a class="back" href="/">Volver al inicio</a></p>
</section>
