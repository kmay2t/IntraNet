@model Meditechnosys.Intranet.Pages.AvisosPanelModel
@{
  // Quien administra ve todos (incluso pausados, para reactivarlos/editarlos/borrarlos);
  // el resto ve únicamente los avisos publicados.
  var visibles = Model.PuedeAdministrar
      ? Model.Todos
      : Model.Todos.Where(a => a.Activo).ToList();
}
<section aria-labelledby="avisos">
  <div class="news-head">
    <h2 id="avisos">Avisos</h2>
    @if (Model.PuedeAdministrar)
    {
      <button type="button" class="btn btn-gold btn-mini" id="btnNuevoAviso">+ Publicar</button>
    }
  </div>
  @if (visibles.Count == 0)
  {
    <p class="news-empty">@(Model.PuedeAdministrar
        ? "No hay avisos todavía. Publica el primero con “+ Publicar”."
        : "No hay avisos por el momento.")</p>
  }
  else
  {
    <ul class="news">
      @foreach (var a in visibles)
      {
        var etiqueta = string.IsNullOrWhiteSpace(a.Etiqueta) ? "Aviso" : a.Etiqueta;
        <li data-pausado="@(a.Activo ? null : "1")">
          <time>@(a.Activo ? etiqueta : etiqueta + " · Pausado")</time>
          <strong>@a.Titulo</strong>
          @if (!string.IsNullOrWhiteSpace(a.Cuerpo))
          {
            <span>@a.Cuerpo</span>
          }
          @if (Model.PuedeAdministrar)
          {
            <span class="news-acc">
              <button type="button" class="btn btn-mini" data-edit="@a.Id"
                      data-titulo="@a.Titulo" data-cuerpo="@a.Cuerpo" data-etiqueta="@a.Etiqueta"
                      data-activo="@(a.Activo ? "1" : "")">Editar</button>
              <button type="button" class="btn btn-mini btn-peligro" data-del="@a.Id" data-titulo="@a.Titulo">Eliminar</button>
            </span>
          }
        </li>
      }
    </ul>
  }

  @if (Model.PuedeAdministrar)
  {
    <dialog id="dlgAviso" class="modal">
      <form class="modal-form" id="formAviso" novalidate>
        <h3 id="dlgAvisoEncabezado">Publicar aviso</h3>
        <p class="modal-error" id="avisoError" role="alert" hidden></p>
        <label>Título
          <input id="avTitulo" name="titulo" maxlength="120" required placeholder="p. ej. Mantenimiento del servidor" />
        </label>
        <label>Etiqueta
          <small>Texto corto en mayúsculas que encabeza el aviso (p. ej. “Esta semana”).</small>
          <input id="avEtiqueta" name="etiqueta" maxlength="60" placeholder="Esta semana" />
        </label>
        <label>Texto
          <small>Opcional. Detalle que se muestra bajo el título.</small>
          <textarea id="avCuerpo" name="cuerpo" rows="3" maxlength="500"></textarea>
        </label>
        <label class="check-line"><input type="checkbox" id="avActivo" checked /> Publicado (visible para todos)</label>
        <div class="modal-actions">
          <button type="button" class="btn" id="avCancelar">Cancelar</button>
          <button type="submit" class="btn btn-gold">Guardar</button>
        </div>
      </form>
    </dialog>
  }
</section>
