@page
@model IndexModel
@{
  ViewData["Title"] = "Inicio";
  var grupos = Model.Apps.GroupBy(a => a.Tag).Select(g => new { Tag = g.Key, Items = g.ToList() }).ToList();
  var primero = true;
}

<section class="hero" id="inicio">
  <p class="eyebrow">@Model.Usuario · @Model.Rol</p>
  <h1 id="saludo">Todo el equipo, <em>en un solo lugar</em></h1>
  <p class="lede">Estas son las herramientas a las que tienes acceso. Busca una o entra directo desde los accesos.</p>
  <label class="search" for="q">
    <input id="q" type="search" placeholder="Buscar herramienta, documento o área" autocomplete="off">
    <kbd>/</kbd>
  </label>
</section>

<div class="grid">
  <main>
    @if (grupos.Count == 0)
    {
      <p class="empty">Tu cuenta todavía no tiene herramientas asignadas. Pídele al Administrador que te asigne un rol o permisos en <b>Roles y permisos</b>.</p>
    }
    @foreach (var grp in grupos)
    {
      <section class="grupo" data-tag="@grp.Tag">
        <h2 id="@(primero ? "accesos" : null)" class="@(primero ? null : "gap")">@grp.Tag</h2>
        <div class="apps">
          @foreach (var a in grp.Items)
          {
            <a class="app" href="@a.Url" data-k="@a.Keywords">
              <span class="tag">@a.Tag</span><span class="name">@a.Name</span>
              <p>@a.Description</p><span class="go">Abrir →</span>
            </a>
          }
        </div>
      </section>
      primero = false;
    }
    <p class="empty" id="empty" hidden>No hay accesos que coincidan con tu búsqueda.</p>
  </main>

  <aside class="side">
    <partial name="_Avisos" model="Model.Panel" />
    <partial name="_Sistemas" model="Model.Systems" />
  </aside>
</div>

@section Scripts {
  @if (Model.Panel.PuedeAdministrar)
  {
    <script src="~/js/avisos.js" asp-append-version="true"></script>
  }
}
