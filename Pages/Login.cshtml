@page
@model LoginModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <script src="~/js/theme.js" asp-append-version="true"></script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Iniciar sesión · Intranet meditechnosys</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body class="theme-login">
  <div class="wrap">
    <section class="brand">
      <svg class="circuit" viewBox="0 0 600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <g stroke="#C9A24B" stroke-width="1.4" fill="none" opacity="0.5">
          <path d="M0 120 H180 L210 150 V260 L250 300 H600" />
          <path d="M0 340 H90 L120 370 V520 L160 560 H600" />
          <path d="M600 660 H430 L400 690 V760 L360 800 H120 L90 830 V900" />
          <path d="M300 0 V80 L330 110 H480 L520 150 V300" />
          <path d="M0 700 H60 L90 730 V900" />
        </g>
        <g fill="#C9A24B">
          <circle cx="180" cy="120" r="3" /><circle cx="250" cy="300" r="3" /><circle cx="580" cy="300" r="3" />
          <circle cx="120" cy="370" r="3" /><circle cx="160" cy="560" r="3" /><circle cx="430" cy="660" r="3" />
          <circle cx="360" cy="800" r="3" /><circle cx="330" cy="110" r="3" /><circle cx="480" cy="110" r="3" />
          <circle cx="520" cy="150" r="3" /><circle cx="90" cy="730" r="3" />
        </g>
      </svg>
      <div class="brand-content">
        <span class="brand-mark">Meditechnosys Group S.A. de C.V.</span>
        <h1>Intranet<br />meditechnosys</h1>
        <p class="brand-sub">Acceso restringido al personal autorizado de Meditechnosys.</p>
      </div>
      <span class="corner-rule" aria-hidden="true"></span>
    </section>

    <section class="panel">
      <div class="panel-inner">
        <header class="panel-head">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <h2>Iniciar sesión</h2>
          <p>Ingresa tus credenciales para continuar.</p>
        </header>

        <form class="login-form" method="post" autocomplete="off">
          <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
          @if (Model.Error is not null)
          {
            <p class="error" role="alert">@Model.Error</p>
          }
          else if (Model.SesionExpiro)
          {
            <p class="aviso-sesion" role="status">Tu sesión terminó por inactividad. Vuelve a entrar; el tiempo que aguanta abierta se cambia en el botón de configuración de la página de inicio.</p>
          }
          <label class="field">
            <span>Usuario</span>
            <input type="text" name="Usuario" value="@Model.Usuario" placeholder="Ej. jgarcia o 12345678901" required autofocus />
          </label>
          <div class="field field-pwd">
            <span id="etiquetaPassword">Contraseña</span>
            <div class="pwd">
              <input type="password" name="Password" id="Password" aria-labelledby="etiquetaPassword" placeholder="••••••••" required autocomplete="current-password" />
              <button type="button" class="ver-pwd" id="btnVerPwd" aria-pressed="false" aria-label="Mostrar la contraseña" title="Mostrar la contraseña">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1.8 12S5.4 5.8 12 5.8 22.2 12 22.2 12 18.6 18.2 12 18.2 1.8 12 1.8 12z" />
                  <circle cx="12" cy="12" r="3.1" />
                  <path class="tacha" d="M4 20 20 4" />
                </svg>
              </button>
            </div>
          </div>
          <div class="row">
            <label class="check">
              <input type="checkbox" name="Remember" value="true" />
              <span>Mantener sesión iniciada</span>
            </label>
            <a href="#" class="forgot">¿Olvidaste tu contraseña?</a>
          </div>
          <button type="submit">Entrar</button>
        </form>
        <p class="footnote">Meditechnosys.mx</p>
      </div>
    </section>
  </div>
  <script>
    // Mostrar u ocultar la contraseña. La preferencia es de cada persona y se recuerda en este
    // equipo (localStorage); si el navegador bloquea el almacenamiento, el botón sigue funcionando
    // solo durante la visita.
    (function () {
      var campo = document.getElementById('Password');
      var boton = document.getElementById('btnVerPwd');
      if (!campo || !boton) return;
      var CLAVE = 'meditechnosys.login.verPassword';
      function aplicar(mostrar) {
        campo.type = mostrar ? 'text' : 'password';
        boton.setAttribute('aria-pressed', mostrar ? 'true' : 'false');
        var texto = mostrar ? 'Ocultar la contraseña' : 'Mostrar la contraseña';
        boton.setAttribute('aria-label', texto);
        boton.title = texto;
        if (mostrar) { boton.classList.add('activo'); } else { boton.classList.remove('activo'); }
      }
      var guardar = '';
      try { guardar = localStorage.getItem(CLAVE) || ''; } catch (e) { guardar = ''; }
      var mostrar = guardar === '1';
      aplicar(mostrar);
      boton.addEventListener('click', function () {
        mostrar = campo.type !== 'text';
        aplicar(mostrar);
        try { localStorage.setItem(CLAVE, mostrar ? '1' : '0'); } catch (e) { }
        campo.focus();
      });
    })();
  </script>
</body>
</html>
